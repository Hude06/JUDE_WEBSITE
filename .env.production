# Loaded by `next build` (NODE_ENV=production). Without this, every canonical
# URL, OG tag, sitemap entry, and robots.txt line falls back to
# http://localhost:3000 — see site/metadata.ts, app/sitemap.ts, app/robots.ts.
NEXT_PUBLIC_SITE_URL=https://judemakes.com

# Superview analytics (components/SuperviewScript.tsx). Read at build time,
# since the layout is prerendered.
SUPERVIEW_SITE=3a1d23da33
SUPERVIEW_SRC=https://judemakes.dev/sv.js
