# App/runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Admin CSRF allow-list override (optional):
# host:port value expected in Origin/Referer checks for mutating /api/admin/* calls.
# Example: admin.example.com
ADMIN_ALLOWED_HOST=

# Fleet stats + analytics endpoint protection.
# Required for /api/fleet/stats AND /api/analytics (the pageview read endpoint
# mission-control pulls). Set the same value in mission-control's MC_FLEET_TOKEN.
FLEET_TOKEN=

# Pageview tracking (first-party, cookieless). Optional.
# ANALYTICS_DATA_PATH: where to snapshot recent events for durability across
#   restarts. Point it at a mounted volume (e.g. /data/analytics.json). If unset,
#   events live in memory only and mission-control re-syncs after a restart.
# MC_TRACK_DISABLED=1 turns the beacon off entirely for a site.
ANALYTICS_DATA_PATH=
MC_TRACK_DISABLED=

# Build metadata for health/stats endpoints (optional but recommended)
BUILD_SHA=
BUILD_TIME=

# Optional analytics script injection
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=

# Build-time flag used by this framework's Next.js config
# Leave empty in normal CI/local use.
SKIP_TYPE_CHECK=
